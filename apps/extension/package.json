{
  "name": "airlock-extension",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "mkdir -p dist && npm run build:sw && npm run build:content && npm run build:proactive && npm run build:popup && cp manifest.json dist/ && cp public/popup.html dist/popup.html",
    "build:sw": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=esm",
    "build:content": "esbuild src/content.ts --bundle --outfile=dist/content.js --format=iife",
    "build:proactive": "esbuild src/proactive.ts --bundle --outfile=dist/proactive.js --format=iife",
    "build:popup": "esbuild src/popup.ts --bundle --outfile=dist/popup.js --format=esm"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}